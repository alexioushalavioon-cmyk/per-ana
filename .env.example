# Shared
APP_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://perana:perana@postgres:5432/perana
AUTH_MODE=dev
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/storage
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=per-ana
R2_REGION=auto
REDIS_URL=redis://redis:6379/0
MAX_UPLOAD_BYTES=52428800

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phase 2 research adapters
SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=

# Phase 8.5: live AI router
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL_LOW=gpt-5.6-luna
AI_MODEL_BALANCED=gpt-5.6-terra
AI_MODEL_STRONG=gpt-5.6-sol
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=5000
AI_MONTHLY_BUDGET_USD=

# Long-running jobs
JOB_BACKEND=inline
JOB_QUEUE_NAME=perana:jobs
JOB_POLL_SECONDS=1
